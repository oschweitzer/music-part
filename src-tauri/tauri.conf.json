{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Music Part",
  "version": "0.1.0",
  "identifier": "dev.musicpart.app",
  "build": {
    "beforeDevCommand": "pnpm --filter ui dev",
    "beforeBuildCommand": "pnpm --filter ui build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Music Part",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../assets/soundfonts/GeneralUser-GS.sf2": "soundfont/GeneralUser-GS.sf2",
      "../assets/soundfonts/GeneralUser-GS-LICENSE.txt": "soundfont/GeneralUser-GS-LICENSE.txt",
      "../assets/soundfonts/banks/nylon-guitar.sf2": "soundfont/banks/nylon-guitar.sf2",
      "../assets/soundfonts/banks/electric-guitar.sf2": "soundfont/banks/electric-guitar.sf2",
      "../assets/soundfonts/banks/electric-bass.sf2": "soundfont/banks/electric-bass.sf2",
      "../assets/soundfonts/banks-LICENSE.txt": "soundfont/banks-LICENSE.txt"
    }
  }
}
